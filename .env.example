# ---------- Discord ----------
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Right-click your server → Copy Server ID (enable Developer Mode first)
DISCORD_GUILD_ID=
# Right-click the text channel for the live chat feed → Copy Channel ID
DISCORD_CHANNEL_ID=
# Optional, comma-separated. Who may send to Twitch. If both are empty,
# only members with "Manage Server" permission can.
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_USER_IDS=

# ---------- Twitch ----------
# From https://dev.twitch.tv/console/apps → your app
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Get this by running: npm run twitch-auth
TWITCH_REFRESH_TOKEN=
# Your channel name (the one you stream on), e.g. carlson
TWITCH_CHANNEL=

# ---------- Behaviour (optional) ----------
# Forward every message typed in the Discord channel to Twitch (toggle with /relay)
AUTO_RELAY=false
# How Discord messages look in Twitch chat. Placeholders: {user} {message}
DISCORD_TO_TWITCH_FORMAT=[Discord] {user}: {message}
# Discord messages starting with this are never forwarded
RELAY_IGNORE_PREFIX=//
# Port for the health-check endpoint (hosts like Render set this automatically)
PORT=3000
